node_modules
dist
data
desktop/src-tauri/target
desktop/src-tauri/gen
.DS_Store
.env*
!.env.example

# .claude/ is committed (skills, slash commands, settings.json define the
# agent contract for this repo). Only the per-contributor and per-session
# files are ignored.
.claude/settings.local.json
.claude/.current-tool

# Local scratch, never committed. mcp-dev/.token is a live dev credential and
# q-inspect.mts dumps real oauth_access_token rows, so neither may be staged.
.omp/
mcp-dev/
q-inspect.mts

# scripts/backup.sh's default output: a full database dump, which is the
# deployment's data and not this repository's.
backups/
